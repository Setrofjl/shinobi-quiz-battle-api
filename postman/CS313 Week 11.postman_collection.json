                  "pm.test('in-use question set answers 409', function () { pm.response.to.have.status(409); });",
                  "pm.expect(pm.response.json().error.code).to.eql('QUESTION_SET_IN_USE');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create disposable question set",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Demo-User", "value": "{{hostSchoolId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Disposable Set\",\"subject\":\"Cleanup\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/question-sets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('disposable set created with 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('deleteSetId', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete unused question set - 204",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Demo-User", "value": "{{hostSchoolId}}" }],
            "url": "{{baseUrl}}/question-sets/{{deleteSetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete answers 204 with no body', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Manual precondition checks",
      "item": [
        {
          "name": "Full session rejects a new player - 409 SESSION_FULL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Demo-User", "value": "{{playerOneSchoolId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nickname\":\"Overflow Player\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/sessions/{{capacitySessionCode}}/players"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('full session answers 409', function () { pm.response.to.have.status(409); });",
                  "pm.expect(pm.response.json().error.code).to.eql('SESSION_FULL');"
                ]
              }
            }
          ],
          "disabled": true
        }
      ]
    }
