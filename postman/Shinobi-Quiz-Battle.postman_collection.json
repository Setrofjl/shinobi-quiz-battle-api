        "url": {
          "raw": "{{baseUrl}}/results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "results"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Results response contains results\", function () { const data = pm.response.json(); pm.expect(data).to.have.property('results'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Results with invalid since value",
      "request": {
        "method": "GET",
        "header": [
          {
