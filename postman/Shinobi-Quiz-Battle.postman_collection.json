            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Invalid date is rejected\", function () { const data = pm.response.json(); pm.expect(data.error.code).to.eql('INVALID_SINCE'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"school_id\":\"ADMIN-TEST-001\",\"password\":\"ShinobiDemo2026!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Admin token is returned\", function () { const data = pm.response.json(); pm.expect(data.token).to.be.a('string'); pm.collectionVariables.set('adminToken', data.token); });",
              "pm.test(\"Admin role is correct\", function () { const data = pm.response.json(); pm.expect(data.user.role).to.eql('ADMIN'); });"
            ]
          }
        }
      ]
    },
