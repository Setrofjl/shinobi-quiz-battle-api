{
  "info": {
    "name": "Shinobi Quiz Battle API - Week 12 M1",
    "description": "Authentication, JWT, RBAC, user management, health, game information, and Hub API tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const id = Date.now().toString();",
          "  pm.collectionVariables.set('runId', id);",
          "  pm.collectionVariables.set('testSchoolId', 'W12-' + id.slice(-12));",
          "  pm.collectionVariables.set('testEmail', 'postman-' + id + '@example.test');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "playerToken",
      "value": ""
    },
    {
      "key": "newPlayerToken",
      "value": ""
    },
    {
      "key": "testUserId",
      "value": ""
    },
    {
      "key": "testSchoolId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Health status is OK\", function () { const data = pm.response.json(); pm.expect(data.status).to.eql('ok'); });",
              "pm.test(\"Database is available\", function () { const data = pm.response.json(); pm.expect(data.database).to.eql('up'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get game information",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/game-info",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "game-info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Game slug is correct\", function () { const data = pm.response.json(); pm.expect(data.slug).to.eql('shinobi-quiz-battle'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Results without Hub key",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "results"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Hub key is required\", function () { const data = pm.response.json(); pm.expect(data.error.code).to.eql('HUB_KEY_REQUIRED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Results with Hub key",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Hub-Key",
            "value": "{{hubKey}}"
          }
